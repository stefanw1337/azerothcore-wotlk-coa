+// Skinshifter: the Qiraji's skins are only in EsteriaPackSkins.bin since 1.9.9; bound with or without armor.
+bool KvQirajiBind(void* character)
+{
+    if (RaceOf(CC<unsigned>(character, 0x18)) != 79)
+        return true;
+    void* instance = CC<void*>(character, 0x38);
+    if (!instance || CC<unsigned>(character, 0x1C) > 1)
+        return true;
+    auto fields = HighmountainFields(character);
+    KvPackBind(character, instance, 79, fields);
+    return true;
+}
