@@ -33,6 +33,36 @@ int CoA::CA::detail::Usage(lua_State* L, const char* msg) {
     return luaL_error(L, msg);
 }
 
+namespace {
+    // CAEnums.generated.inc lists CoA's own class and tab types, ending in MaxClass / MaxTab. A row added to the
+    // tables after them (another class's trees) is found by its name in the table, as its row id.
+    uint32_t AddedTypeByName(const char* name, const char* const* names, uint32_t count) {
+        CoA::Dbc::Table* table = nullptr;
+
+        if (count && strcmp(names[count - 1], "MaxClass") == 0) {
+            table = &ClassTypes();
+        } else if (count && strcmp(names[count - 1], "MaxTab") == 0) {
+            table = &TabTypes();
+        }
+
+        if (!table || !name) {
+            return 0;
+        }
+
+        for (uint32_t i = 0; i < table->Count(); ++i) {
+            const uint8_t* row = table->RowAt(i);
+
+            const char* rowName = row ? table->Str(row, 4) : nullptr;
+
+            if (rowName && strcmp(rowName, name) == 0) {
+                return CoA::Dbc::Table::U32(row, 0);
+            }
+        }
+
+        return 0;
+    }
+}
