+std::string CoA::CA::detail::ClassTypeName(uint32_t cls) {
+    if (cls >= 1 && cls < 0x2F) {
+        return kClassTypes[cls - 1];
+    }
+
+    if (const uint8_t* ct = ClassTypes().Row(cls)) {
+        return ClassTypes().Str(ct, 4);
+    }
+
+    return "UNEXPECTED_ENUM_VALUE_" + std::to_string(cls);
+}
+
+std::string CoA::CA::detail::TabTypeName(uint32_t tab) {
+    if (tab >= 1 && tab < 0x5F) {
+        return kTabTypes[tab - 1];
+    }
+
+    if (const uint8_t* tt = TabTypes().Row(tab)) {
+        return TabTypes().Str(tt, 4);
+    }
+
+    return "UNEXPECTED_ENUM_VALUE_" + std::to_string(tab);
+}
