@@ -52,6 +52,57 @@ static const uint8_t s_volumeEdges[32] = { 0, 1, 0, 2, 0, 3, 0, 4, 1, 2, 2, 3, 3
 // STATIC: 0x00ADBA34
 static World::FacetData s_moveFacets;
 
+// Skinshifter: what Root Walking and Wraith Glide pass through (all but terrain and water).
+static constexpr uint32_t kSkinshifterThroughFlags = 0x00F020FFu;
+static World::FacetData s_skinshifterTerrain;
+
+// Skinshifter: the facets the movement collides with. Under Wraith Glide (spell 1990015) a building, tree or fence
+// only keeps the faces you can stand on (a floor, a bridge deck, stairs: no steeper than the walkable 50 degrees), so
+// you glide through walls but not through the floor; terrain and water stay whole.
+static bool SkinshifterMoveFacets(CGUnit_C* unit, CAaBox* box, CAaBox* query, uint32_t flags) {
+    bool found = box ? World::GetFacets(box, query, &s_moveFacets, flags, nullptr) : World::GetFacets(query, &s_moveFacets, flags, nullptr);
+
+    if (!found || !unit || !unit->HasAuraBySpellId(1990015)) {
+        return found;
+    }
+
+    uint32_t terrainFlags = flags & ~kSkinshifterThroughFlags;
+    bool terrain = box ? World::GetFacets(box, query, &s_skinshifterTerrain, terrainFlags, nullptr) : World::GetFacets(query, &s_skinshifterTerrain, terrainFlags, nullptr);
+    bool ids = s_moveFacets.facetIds.m_count == s_moveFacets.facets.m_count;
+    uint32_t kept = 0;
+
+    for (uint32_t i = 0; i < s_moveFacets.facets.m_count; i++) {
+        const CFacet& facet = s_moveFacets.facets.m_data[i];
+        bool keep = facet.plane.n.z > 0.64278764f;
+
+        for (uint32_t j = 0; !keep && terrain && j < s_skinshifterTerrain.facets.m_count; j++) {
+            keep = memcmp(facet.v, s_skinshifterTerrain.facets.m_data[j].v, sizeof(facet.v)) == 0;
+        }
+
+        if (!keep) {
+            continue;
+        }
+
+        if (kept != i) {
+            s_moveFacets.facets.m_data[kept] = facet;
+
+            if (ids) {
+                s_moveFacets.facetIds.m_data[kept] = s_moveFacets.facetIds.m_data[i];
+            }
+        }
+
+        kept++;
+    }
+
+    s_moveFacets.facets.SetCount(kept);
+
+    if (ids) {
+        s_moveFacets.facetIds.m_count = kept;
+    }
+
+    return found;
+}
+
