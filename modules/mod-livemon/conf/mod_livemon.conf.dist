[worldserver]

########################################
# LiveMon: live statistics for the LiveMon window
########################################
#
#    LiveMon.Enable
#        Description: Collect damage, healing, crowd control, deaths, kills, combat time and movement per character
#                     and serve them to the LiveMon window.
#        Default:     1 - (Enabled)
#                     0 - (Disabled)

LiveMon.Enable = 1

#
#    LiveMon.Bind
#        Description: Address the live feed listens on. Keep 127.0.0.1 so only this computer can read it.
#        Default:     "127.0.0.1"

LiveMon.Bind = "127.0.0.1"

#
#    LiveMon.Port
#        Description: Port of the live feed (http://127.0.0.1:<port>/live).
#        Default:     8089

LiveMon.Port = 8089

#
#    LiveMon.FlushSeconds
#        Description: How often the minute totals are written to the livemon_minute table (at least 10).
#        Default:     60

LiveMon.FlushSeconds = 60
